# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.6-python3.11-bookworm-slim

WORKDIR /mlflow

COPY requirements-mlflow.txt ./

# BuildKit cache mount — колесо скачивается один раз и кешируется между сборками
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements-mlflow.txt

RUN mkdir -p /mlflow/artifacts

EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:///mlflow.db", \
     "--default-artifact-root", "mlflow-artifacts:/", \
     "--serve-artifacts"]
